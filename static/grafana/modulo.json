    {
      "id": 15,
      "title": "不可比较／复算缺口分类",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
