    {
      "id": 10,
      "title": "处理对象内复算覆盖率",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "采样时分母是抽中调用数；全量时分母是筛选后的调用数。总体覆盖率见下方仅买方内部可见的面板。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "无可用数据"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(scope,direction) ((last_over_time(modulo_recalculated_calls{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) and on(scope,adapter,platform,model) (last_over_time(modulo_group_snapshot_timestamp_seconds{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) == on(scope) group_left last_over_time(modulo_snapshot_timestamp_seconds{scope=~\"$scope\"}[$__range])))) / on(scope) group_left () (sum by(scope) ((last_over_time(modulo_calls{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) and on(scope,adapter,platform,model) (last_over_time(modulo_group_snapshot_timestamp_seconds{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) == on(scope) group_left last_over_time(modulo_snapshot_timestamp_seconds{scope=~\"$scope\"}[$__range])))) > 0))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 11,
      "title": "处理对象内比较覆盖率",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "采样时分母是抽中调用数；全量时分母是筛选后的调用数。总体覆盖率见下方仅买方内部可见的面板。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "无可用数据"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(scope,direction) ((last_over_time(modulo_compared_calls{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) and on(scope,adapter,platform,model) (last_over_time(modulo_group_snapshot_timestamp_seconds{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) == on(scope) group_left last_over_time(modulo_snapshot_timestamp_seconds{scope=~\"$scope\"}[$__range])))) / on(scope) group_left () (sum by(scope) ((last_over_time(modulo_calls{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) and on(scope,adapter,platform,model) (last_over_time(modulo_group_snapshot_timestamp_seconds{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) == on(scope) group_left last_over_time(modulo_snapshot_timestamp_seconds{scope=~\"$scope\"}[$__range])))) > 0))",
          "instant": true,
