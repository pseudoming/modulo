      }
    },
    {
      "id": 8,
      "title": "调用数与供应商／模型",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无可用数据"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(last_over_time(modulo_calls{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) and on(scope,adapter,platform,model) (last_over_time(modulo_group_snapshot_timestamp_seconds{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) == on(scope) group_left last_over_time(modulo_snapshot_timestamp_seconds{scope=~\"$scope\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 9,
      "title": "整体／输入／输出结论",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无可用数据"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(last_over_time(modulo_verdict_calls{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) and on(scope,adapter,platform,model) (last_over_time(modulo_group_snapshot_timestamp_seconds{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) == on(scope) group_left last_over_time(modulo_snapshot_timestamp_seconds{scope=~\"$scope\"}[$__range])))",
