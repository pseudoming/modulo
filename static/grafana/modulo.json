      "targets": [
        {
          "refId": "A",
          "expr": "sum by(scope,direction) ((last_over_time(modulo_verdict_calls{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\",direction=~\"input|output\",verdict=\"DEVIATION\"}[$__range]) and on(scope,adapter,platform,model) (last_over_time(modulo_group_snapshot_timestamp_seconds{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) == on(scope) group_left last_over_time(modulo_snapshot_timestamp_seconds{scope=~\"$scope\"}[$__range])))) / (sum by(scope,direction) ((last_over_time(modulo_compared_calls{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) and on(scope,adapter,platform,model) (last_over_time(modulo_group_snapshot_timestamp_seconds{scope=~\"$scope\",platform=~\"$platform\",model=~\"$model\"}[$__range]) == on(scope) group_left last_over_time(modulo_snapshot_timestamp_seconds{scope=~\"$scope\"}[$__range])))) > 0)",
